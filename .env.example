# Copy to .env and adjust as needed. Never commit the real .env file.

# --- Database ---
POSTGRES_USER=docuquest
POSTGRES_PASSWORD=docuquest_dev_password
POSTGRES_DB=docuquest
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://docuquest:docuquest_dev_password@db:5432/docuquest

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- File handling ---
STORAGE_ROOT=/data/storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# --- OCR / AI (optional) ---
# If TESSERACT_CMD is not set, pytesseract uses the system PATH (set in Docker image).
TESSERACT_CMD=
# Optional: set to enable LLM-assisted extraction as a secondary pass. Leave blank to
# run in fully offline/rule-based mode (no external AI credentials required).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ENVIRONMENT=development
